NEXT_PUBLIC_EDGAR_USER_AGENT="Your Name contact@yourdomain.com"
VITE_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
# Optional localhost fallback for SEC full-text search when efts.sec.gov blocks local dev requests
VITE_SEC_PROXY_FALLBACK_BASE="https://vara-ai-app.vercel.app"
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"

# Enriched search (optional) — EDGAR EFTS full text + Supabase metadata facets
# (auditor from PCAOB Form AP, exact form/date/SIC). Replaces the retired
# Elastic Cloud cluster. Apply db/migrations/001_urc_sec_metadata.sql, run the
# data-pipeline loaders, then enable:
# NEXT_PUBLIC_USE_ENRICHED_SEARCH="true"
# URC_SUPABASE_URL="https://your-project.supabase.co"
# URC_SUPABASE_SERVICE_KEY="your-service-role-key"
# (NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY work as fallbacks,
#  and the legacy NEXT_PUBLIC_USE_ELASTICSEARCH flag name is still honored)

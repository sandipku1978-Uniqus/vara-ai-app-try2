# Public application origin and SEC contact identity
NEXT_PUBLIC_SITE_URL="http://localhost:3033"
NEXT_PUBLIC_EDGAR_USER_AGENT="Your Organization contact@example.com"

# Clerk. Production requires live keys and a configured feature entitlement.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_for_local_development"
CLERK_SECRET_KEY="sk_test_replace_for_local_development"
# Accepted forms: user:<feature-slug> or org:<feature-slug>
CLERK_RESEARCH_FEATURE="org:research"

# Anthropic AI (server only)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"
AI_DAILY_TOKEN_BUDGET_PER_USER="250000"
# Deployment-wide daily AI ceiling across ALL users (defaults to 8x per-user).
AI_DAILY_TOKEN_BUDGET_GLOBAL="2000000"
AI_MAX_CONCURRENT_PER_USER="2"
AI_MAX_CONCURRENT_PER_ORG="10"

# Vercel KV / distributed rate limits and summary cache (server only)
KV_REST_API_URL="https://your-kv-endpoint.example.com"
KV_REST_API_TOKEN="your-kv-token"

# Enriched search and application data
NEXT_PUBLIC_USE_ENRICHED_SEARCH="true"
URC_SUPABASE_URL="https://your-project.supabase.co"
# Restricted application/web role used by authenticated production routes
URC_SUPABASE_WEB_KEY="your-restricted-web-role-key"
# Service role is reserved for trusted ingestion/maintenance jobs
URC_SUPABASE_SERVICE_KEY="your-service-role-key"

# Optional, consent-aware analytics
NEXT_PUBLIC_POSTHOG_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Local development and testing only (never set on Vercel)
# URC_E2E_BYPASS_AUTH=1 lets Playwright E2E runs skip Clerk locally; ignored when VERCEL is set.
URC_E2E_BYPASS_AUTH=""
# NEXT_LOCAL_BUILD=1 writes local `next build` output to .next-build so it never collides with `next dev`.
NEXT_LOCAL_BUILD=""

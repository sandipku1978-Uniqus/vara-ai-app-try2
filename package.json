{
  "name": "comparable-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_LOCAL_BUILD=1 next build",
    "start": "NEXT_LOCAL_BUILD=1 next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:ui:smoke": "playwright test tests/e2e/route-smoke.spec.ts",
    "test:ui:audit": "playwright test tests/e2e/semantic-census.spec.ts",
    "test:ui:visitor": "playwright test tests/e2e/neutral-visitor.spec.ts",
    "validate:ui-actions": "tsx scripts/ui-actions/validate.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:cycles": "node scripts/check-dependency-cycles.mjs",
    "ingest:metadata": "tsx data-pipeline/ingest-metadata.ts",
    "ingest:auditors": "tsx data-pipeline/load-auditors.ts",
    "ingest:letters": "tsx data-pipeline/ingest-letters.ts",
    "ingest:letter-text": "tsx data-pipeline/fetch-letter-text.ts",
    "enrich:companies": "tsx data-pipeline/enrich-companies.ts",
    "test:ui:boolean": "playwright test tests/e2e/boolean-search.spec.ts",
    "accuracy": "tsx scripts/accuracy/gate.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clerk/nextjs": "^7.9.10",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/kv": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.8.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.50.0",
    "next": "^16.2.12",
    "posthog-js": "^1.435.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.42",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "postcss": "^8.5.20",
    "sharp": "^0.35.3"
  }
}
